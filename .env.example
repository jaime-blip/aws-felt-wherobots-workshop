# Wherobots Cloud
WHEROBOTS_API_KEY=your-wherobots-api-key

# Amazon Aurora PostgreSQL (PostGIS)
AURORA_DSN=postgresql://user:password@your-host:5432/dbname

# Felt source name — the agent resolves this to a source_id at startup via
# the Felt API. The source with this name must be connected to your Aurora
# cluster in the Felt UI. Defaults to "workshop-db" if unset.
FELT_SOURCE_NAME=workshop-db

# Felt API
FELT_API_TOKEN=your-felt-api-token

# AWS (for Bedrock) — use access keys OR profile, not both
# Option 1: Explicit credentials (recommended for workshops)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=optional-session-token  # only if using temporary credentials

# Option 2: Named profile (comment out the keys above)
# AWS_PROFILE=default

AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7

# PostgreSQL (PostGIS)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
