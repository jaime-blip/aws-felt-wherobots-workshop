# Wherobots Cloud
WHEROBOTS_API_KEY=your-wherobots-api-key

# Amazon Aurora PostgreSQL (PostGIS)
AURORA_DSN=postgresql://user:password@your-host:5432/dbname

# Felt source name — the agent resolves this to a source_id at startup via
# the Felt API. The source with this name must be connected to your Aurora
# cluster in the Felt UI. Defaults to "workshop-db" if unset.
FELT_SOURCE_NAME=workshop-db

# Felt API
FELT_API_TOKEN=your-felt-api-token

# AWS (for Bedrock)
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-7

# PostgreSQL (PostGIS)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
