# Wherobots Cloud
WHEROBOTS_API_KEY=your-wherobots-api-key

# Amazon Aurora PostgreSQL (PostGIS)
AURORA_HOST=your-cluster.cluster-xxxx.us-west-2.rds.amazonaws.com
AURORA_PORT=5432
AURORA_DB=workshop
AURORA_USER=postgres
AURORA_PASSWORD=your-password

# Felt API
FELT_API_TOKEN=your-felt-api-token

# AWS (for Bedrock)
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-west-2
