# Wherobots Cloud
WHEROBOTS_API_KEY=your-wherobots-api-key

# Amazon Aurora PostgreSQL (PostGIS)
AURORA_DSN=postgresql://user:password@your-host:5432/dbname

# Felt source name — single source of truth for the Aurora data source's name
# in Felt. Setup Step 6's create command names the source from this value, and
# the Part 2 agent looks the source up by this same value, so they always
# match. Defaults to "workshop-db" if unset.
FELT_SOURCE_NAME=workshop-db

# Felt API
FELT_API_TOKEN=your-felt-api-token

# AWS (for Bedrock) — leave everything below commented to use your default AWS
# credentials (e.g. `aws sso login` or your default profile); that's enough for
# most setups. Otherwise uncomment ONE option. Do NOT leave the placeholder keys
# active — env-var keys override your profile/SSO and cause "security token invalid".
# Option 1 — explicit keys (only if you have static credentials):
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=optional-session-token   # only for temporary credentials
# Option 2 — named profile:
# AWS_PROFILE=default

AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-8

# PostgreSQL (PostGIS)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
