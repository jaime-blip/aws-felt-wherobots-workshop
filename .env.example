# Wherobots Cloud
WHEROBOTS_API_KEY=your-wherobots-api-key

# Amazon Aurora PostgreSQL (PostGIS)
AURORA_DSN=postgresql://user:password@your-host:5432/dbname

# Felt Source ID (the source connected to your Aurora DB in Felt)
FELT_SOURCE_ID=your-felt-source-id

# Felt API
FELT_API_TOKEN=your-felt-api-token

# AWS (for Bedrock)
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-west-2

# PostgreSQL (PostGIS)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
