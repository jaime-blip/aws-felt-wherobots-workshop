{
  "mcpServers": {
    "wherobots": {
      "command": "uvx",
      "args": ["wherobots-mcp"],
      "env": {
        "WHEROBOTS_API_KEY": "${WHEROBOTS_API_KEY}"
      }
    },
    "felt": {
      "command": "npx",
      "args": ["-y", "@anthropic/felt-mcp-server"],
      "env": {
        "FELT_API_TOKEN": "${FELT_API_TOKEN}"
      }
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${AURORA_DSN}"
      ],
      "env": {
        "AURORA_DSN": "${AURORA_DSN}"
      }
    }
  }
}
